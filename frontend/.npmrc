# npm-compatible defenses. This repo uses npm (package-lock.json), so any
# pnpm-only settings (`minimum-release-age`, `auto-install-peers`, …) would be
# silently ignored — keep them out.

# Block install when the active Node version doesn't satisfy the `engines`
# range in package.json (CLAUDE.md pins Node >= 22.11.0). Prevents native
# modules from being built against a version we don't support.
engine-strict=true

# Fail `npm audit` (run in CI) on advisories rated high or above. Lower
# severities stay visible but non-blocking — they're often transitive noise.
audit-level=high

# Quieter installs — drop the funding banners from CI logs.
fund=false

# Supply-chain note: the release-age quarantine we'd ideally want here
# (refuse package versions published less than N days ago) has no native npm
# config. Implement it in CI or in the dep-update bot instead:
#   - GitHub Renovate: `minimumReleaseAge: "7 days"` in renovate.json
#   - Dependabot: `cooldown: { default-days: 7 }` in dependabot.yml
#   - Or a CI step that runs `npm view <pkg>@<version> time` before merge.
